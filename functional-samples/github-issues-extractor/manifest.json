{
  "manifest_version": 3,
  "name": "GitHub Issues Extractor",
  "version": "1.0",
  "description": "Extracts issues information from GitHub issues page and displays in a table",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/GoogleChrome/chrome-extensions-samples/issues*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/GoogleChrome/chrome-extensions-samples/issues*"]
}