{
  "manifest_version": 3,
  "name": "AI新闻总结小助手",
  "version": "1.0.0",
  "description": "使用大模型API总结当前页面的新闻内容成100字以内的摘要",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.163.com/*", "https://*.sina.com.cn/*", "https://*.qq.com/*", "https://*.sohu.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
