{
  "manifest_version": 3,
  "name": "AI新闻总结小助手",
  "version": "1.0.0",
  "description": "使用AI将新闻内容总结成100字以内的摘要",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://*.163.com/*", "<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}