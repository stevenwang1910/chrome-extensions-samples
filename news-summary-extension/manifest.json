{
  "manifest_version": 3,
  "name": "AI新闻总结小助手",
  "version": "1.0.0",
  "description": "使用大模型API智能总结网易新闻内容，支持多个API渠道配置",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.163.com/*",
    "http://*.163.com/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI新闻总结小助手"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.163.com/*",
        "https://news.163.com/*",
        "https://dy.163.com/*",
        "https://www.163.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
