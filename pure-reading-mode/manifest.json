{
  "manifest_version": 3,
  "name": "纯净阅读模式",
  "version": "1.0",
  "description": "为网易新闻等页面提供纯净阅读体验，隐藏广告和干扰元素",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.163.com/*", "*://*.163dy.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "128": "images/icon.svg"
  }
}